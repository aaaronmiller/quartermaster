  # Disabled 2026-08-23: /home/cheta/git/skills no longer exists. `qm library
  # prepare` is all-or-nothing, so this one dead path was rejecting the whole
  # plan with "nothing was changed" -- which is why the library never
  # materialised past its first three links. Retired with `enabled: false`
  # rather than deleted, so the entry survives if the repo comes back.
  - id: skills-repo
    class: third-party
    path: /home/cheta/git/skills
    trusted: false
