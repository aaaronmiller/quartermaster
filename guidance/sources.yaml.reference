  # The Living Documents onboarding skill ships from the project's own
  # repository alongside the main skill, which is already registered as
  # `living-documents`. It was the only skill sync.sh deployed that had no
  # entry here: 228 of the 229 it deploys were already catalogued, matched on
  # the directory name rather than the frontmatter `name:` field.
  # gstack ships its deployable, harness-prefixed builds under `.agents/skills/`
  # — 54 skills named `gstack-<verb>`. The catalog scanner skips every directory
  # whose name begins with a dot (scanner.ts, `entry.name.startsWith('.')`), so
  # scanning the repo root finds only the unprefixed source dirs and none of the
  # builds. Zero catalog rows contained `/.agents/` before this entry.
  #
  # Registering the inner path explicitly is the general remedy for any source
  # that keeps artifacts inside a dot-directory: the scan starts below the dot
  # instead of having to traverse it. Prefer this over changing the skip rule,
  # which exists to keep .git and friends out of the catalogue.
  - id: gstack-agents-builds
    class: third-party
    path: /home/cheta/git/gstack/.agents/skills
    trusted: false
    lifecycle: active
    updatePolicy: pull-fast-forward
    tags: [harness-builds, gstack]

  - id: living-documents-onboard
    class: first-party
    path: /home/cheta/code/living-documents/skill-onboard
    remote: https://github.com/aaaronmiller/living-documents.git
    trusted: true
    lifecycle: active
    updatePolicy: manual
    tags: [user-authored, canonical, onboarding]
